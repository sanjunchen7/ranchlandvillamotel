# Backend
APP_ID=
APP_SECRET=

# Database
DATABASE_URL=mysql://user:password@host:3306/database

# Initial staff passwords (used only when the account is first seeded)
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
FRONTDESK_INITIAL_PASSWORD=replace-with-a-strong-frontdesk-password

# Optional SMTP delivery. Without these values, messages stay honestly marked QUEUED.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Platform-injected object storage credentials (do not invent or commit values)
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
KIMI_STORAGE_RESOURCE_ID=
